# CDN 边缘节点：缓存点播对象，转发直播流
proxy_cache_path /var/cache/nginx/edge levels=1:2 keys_zone=vodcache:50m max_size=10g inactive=7d use_temp_path=off;

server {
    listen 80;
    server_name _;

    # 节点健康检查
    location = /edge/health {
        default_type application/json;
        return 200 '{"ok":true,"edge":"${EDGE_NAME}"}';
    }

    # ---- 直播: HTTP-FLV 透传（不可缓存，关闭缓冲保证低延迟）----
    location ~ ^/live/.+\.flv$ {
        proxy_pass ${ORIGIN_LIVE};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        add_header Access-Control-Allow-Origin * always;
    }

    # ---- 直播: HLS（m3u8 短缓存，ts 分片可缓存，实现边缘扇出）----
    location ~ ^/live/.+\.m3u8$ {
        proxy_pass ${ORIGIN_LIVE};
        proxy_set_header Host $host;
        proxy_cache vodcache;
        proxy_cache_valid 200 1s;
        add_header Access-Control-Allow-Origin * always;
        add_header X-Edge-Cache $upstream_cache_status always;
    }
    location ~ ^/live/.+\.ts$ {
        proxy_pass ${ORIGIN_LIVE};
        proxy_set_header Host $host;
        proxy_cache vodcache;
        proxy_cache_valid 200 60s;
        add_header Access-Control-Allow-Origin * always;
        add_header X-Edge-Cache $upstream_cache_status always;
    }

    # ---- 点播: MinIO 对象（视频/缩略图/字幕/录像），强缓存 ----
    location /storage/ {
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_pass ${ORIGIN_STORAGE};
        proxy_set_header Host $proxy_host;
        proxy_cache vodcache;
        proxy_cache_valid 200 206 7d;
        proxy_cache_key $uri$slice_range;
        slice 4m;
        proxy_set_header Range $slice_range;
        proxy_force_ranges on;
        add_header Access-Control-Allow-Origin * always;
        add_header X-Edge-Cache $upstream_cache_status always;
    }
}
